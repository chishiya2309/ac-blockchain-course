# Local compile/tests require no environment variables.
LOCALHOST_RPC_URL=http://127.0.0.1:8545

# Prefer `npx hardhat keystore set NAME` for private keys.
# Private keys must contain 0x followed by 64 hexadecimal characters.
# SEPOLIA_RPC_URL=https://your-sepolia-rpc
# TESTNET_PRIVATE_KEY=
# MAINNET_RPC_URL=https://your-ethereum-mainnet-rpc
# MAINNET_PRIVATE_KEY=
# ETHERSCAN_API_KEY=

# Optional: override the default chain-<chainId> journal for interaction scripts.
# DEPLOYMENT_ID=chain-31337
