# Copy file nay thanh .env va tu dien gia tri tren may cua ban.
# Khong gui private key trong chat va khong commit .env.
# Compile, test va smoke local KHONG can .env.

# HTTPS JSON-RPC cua Ethereum Sepolia (chain ID 11155111), vi du tu nha cung cap RPC.
# Khong dung Ethereum mainnet, Base Sepolia hoac Arbitrum Sepolia.
SEPOLIA_RPC_URL=

# Private key cua vi TESTNET co Sepolia ETH de tra gas cho deploy va register.
# Dinh dang: 0x + 64 ky tu hex. Khong dien seed phrase hoac dia chi vi vao day.
TESTNET_PRIVATE_KEY=

# API key Etherscan, dung de verify source/ABI tren sepolia.etherscan.io.
ETHERSCAN_API_KEY=

# Tuy chon cho node local; khong anh huong RPC Sepolia.
LOCALHOST_RPC_URL=http://127.0.0.1:8545

# Tuy chon khi deploy voi --deployment-id rieng.
# Neu bo trong, script doc chain-11155111 tren Sepolia, chain-31337 tren local.
# DEPLOYMENT_ID=chain-11155111
